mod.wizards.newContentElement.wizardItems.plugins {
    header = Plugins
    elements {
        plugins_tx_newsletterregistration_newsletterregistration {
            iconIdentifier = newsletterregistration-plugin-newsletter
            title = LLL:EXT:newsletterregistration/Resources/Private/Language/locallang.xlf:pluginLabel
            description = LLL:EXT:newsletterregistration/Resources/Private/Language/locallang.xlf:pluginDescription
